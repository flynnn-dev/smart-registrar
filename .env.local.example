# Smart Registrar environment variables
# Copy this file to `.env.local` and fill in values from the Supabase dashboard.
# Never commit `.env.local` or any file that contains real secrets.

# Project URL — Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / publishable key — Settings → API
# Safe for the browser. Do not use the service role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional alias used by newer Supabase dashboards
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this to the browser or commit it.
# Required later for privileged admin/seed operations, not for Phase 2.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional. Used by the Supabase CLI to apply migrations (`supabase db push`).
# Project Settings → Database → Database password
# SUPABASE_DB_PASSWORD=

# Auth → URL Configuration
# Local Site URL: http://localhost:3000
# Production Site URL: https://smart-registrar.vercel.app
# Redirect allow list:
#   http://localhost:3000/auth/callback
#   https://smart-registrar.vercel.app/auth/callback
# For local demos, you can turn off "Confirm email" in Auth settings.
# Do not put SUPABASE_SERVICE_ROLE_KEY or SUPABASE_DB_PASSWORD on Vercel.
